# ARMOR-NODE-ELECTRICAL - the FIRST settings of one node. Copy to secrets/<node-id>.conf and edit (that copy is git-ignored).
#
# These values only seed a freshly flashed node. After the first start the node's own web panel holds its settings (Wi-Fi, broker, ports, users) in
# flash, and this file no longer matters to that node. A build with none of the identity lines is a generic image that is configured entirely from the panel.

CONFIG_ARMOR_NODE_ID="electrical-1"
# replace with the address of your broker (192.0.2.x is reserved for documentation)
CONFIG_ARMOR_MQTT_URI="mqtt://192.0.2.10:18883"
CONFIG_ARMOR_MQTT_USERNAME="electrical-node-electrical-1"
CONFIG_ARMOR_MQTT_PASSWORD="the password printed once by mqtt_identity.sh add electrical-node electrical-1"

# The code that lets the first administrator be created from the node's panel (8 to 32 characters). Empty: a new random code at every start, shown on the
# USB console every 15 seconds. Leave it empty here: a code written in a file that is copied is a code that everybody who copies it has (it is also the password of the set-up access point).
CONFIG_ARMOR_SETUP_CODE=""
