menu "A.R.M.O.R. electrical node"

# The board the image is for. tools/build_node.sh NODE BOARD picks it (sdkconfig.board.<board>); the two profiles differ in the pin table, in the default way in
# (the cable or Wi-Fi) and in whether the W5500 Ethernet driver is built.
choice ARMOR_BOARD
    prompt "Board"
    default ARMOR_BOARD_S3_WIFI

config ARMOR_BOARD_S3_WIFI
    bool "s3-wifi: ESP32-S3-WROOM-1 N16R8 (no Ethernet; Wi-Fi only)"

config ARMOR_BOARD_S3_ETH
    bool "s3-eth: Waveshare ESP32-S3-ETH (W5500 Ethernet over SPI)"

endchoice

# Almost everything a node needs is set in its web panel and stored in flash. The values below are only the FIRST settings of a freshly flashed node (used
# while the flash holds no configuration), so a node can leave the bench already knowing its identity and its broker, and a build with all of them empty is a
# generic image that is configured entirely from the panel.

config ARMOR_NODE_ID
    string "First node identifier (empty: electrical-<last three bytes of the MAC>)"
    default ""
    help
        Lowercase letters, digits, '-' and '_' (1 to 64, not starting with '-' or '_').
        Each node needs its own identity on the broker (ARMOR-DEVOPS: scripts/mqtt_identity.sh add electrical-node ID).

config ARMOR_SETUP_CODE
    string "Setup code (empty: a new random one at every start, shown on the USB console)"
    default ""
    help
        The first administrator of a node is created with this code, from the panel. 8 to 32 characters.

config ARMOR_FLEET_SECRET
    string "Fleet secret: every board's set-up code is derived from it and its MAC (empty: not used)"
    default ""
    help
        With a secret here, the set-up code of a board is made from the secret and the board's own MAC address, so the same universal image gives each board a
        different code. The secret ends up inside the image: it protects a fleet against the network, not against someone holding a board. 16 characters or more.

menu "Ethernet (W5500 over SPI)"
    depends on ARMOR_BOARD_S3_ETH

config ARMOR_ETH_SPI_HOST
    int "SPI host of the W5500 (1 = SPI2, 2 = SPI3)"
    range 1 2
    default 1
config ARMOR_ETH_MOSI
    int "W5500 MOSI GPIO"
    default 11
config ARMOR_ETH_MISO
    int "W5500 MISO GPIO"
    default 12
config ARMOR_ETH_SCLK
    int "W5500 SCLK GPIO"
    default 13
config ARMOR_ETH_CS
    int "W5500 chip select GPIO"
    default 14
config ARMOR_ETH_INT
    int "W5500 interrupt GPIO"
    default 10
config ARMOR_ETH_RST
    int "W5500 reset GPIO (-1 if not wired)"
    default 9
config ARMOR_ETH_SPI_MHZ
    int "SPI clock in MHz"
    range 1 40
    default 20
    help
        The W5500 accepts much more; 20 MHz leaves margin on jumper wires.

endmenu

menu "Broker (first settings)"

config ARMOR_MQTT_URI
    string "MQTT broker URI (empty: none yet)"
    default ""
config ARMOR_MQTT_USERNAME
    string "MQTT username (one identity per node)"
    default ""
config ARMOR_MQTT_PASSWORD
    string "MQTT password"
    default ""
config ARMOR_NTP_SERVER
    string "NTP server (message timestamps are wall-clock time)"
    default "pool.ntp.org"
    help
        The node publishes nothing until its clock is set. On a network without Internet access, point this at a server of your own.
config ARMOR_HEARTBEAT_S
    int "Connection keep-alive base in seconds (the broker is told twice this)"
    range 2 300
    default 10

endmenu

endmenu
