# ARMOR-NODE-ELECTRICAL defaults. Copyright (C) 2026 JuanenRac (Electro Hobby 3D). GPL-3.0-or-later.
#
# The board is an ESP32-S3-DevKitC-1 style ESP32-S3-WROOM-1 N16R8 (16 MB flash, 8 MB octal PSRAM) with two USB-C sockets: "USB & OTG" (the chip's native
# USB, GPIO 19 and 20) and "USB to serial" (a CH343P on UART0, GPIO 43 and 44). The console is moved to the native USB Serial/JTAG so that all three
# hardware UARTs are free for the equipment; the serial log comes out of the "USB & OTG" socket, the same one used to flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# A node that stops answering must recover by itself: the task watchdog resets a stuck task.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
# The stack each task has left is read from FreeRTOS (the panel shows it, and the log warns when a task is short of it).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Two application slots for over-the-air updates (partitions.csv); the boot loader goes back to the previous image when a new one does not confirm itself.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The N16R8 module carries 8 MB of octal PSRAM. If it does not answer the node still starts, without it (a wrong guess must not brick a board).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
# A request of up to 4096 bytes goes to the internal memory first (sockets, the rings of the UARTs, the small objects of the drivers), a bigger one to the external RAM first (the strings, vectors and
# JSON texts of the panel, which the stock 16384 kept in the internal memory); either falls back to the other kind when the first is full. 32 KB of the internal memory stay for what must be
# there (DMA buffers, the stack of a new task) and for nothing else: a normal request reaches them only when everything else is gone.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# A task may have its stack in the external RAM (xTaskCreateStatic): main/psram_mem.hpp says which ones may, and none that touches the flash does.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

CONFIG_LWIP_MAX_SOCKETS=16
# The default (512 bytes) is too small for a real browser's request headers (cookies, Sec-CH-UA client hints, Accept-*):
# once a session exists, a real request can be refused outright ("Header fields are too long", a blank page).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
# The HTTPS panel: a second server with its own certificate; the TLS buffers are released while a connection is idle.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# The TLS buffers go to the external memory: with a browser on the HTTPS panel and the download from GitHub at the same time the internal memory ran out (alloc failed, connect_failed).
# This is the custom mode, not the stock "external" one: the stock mode answers NULL to every request on a board whose PSRAM is absent or did not start, and no TLS (the HTTPS panel, the
# update from GitHub, an encrypted broker link) would work there at all. The custom allocator (armor::memory::install_tls_allocator, called first thing in app_main) takes the external RAM
# and falls back to the internal memory.
CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# The node makes its own certificate on the first boot in this task: mbedTLS needs several KB of stack to write a certificate (a 4 KB output buffer
# of its own), and 6144 overflowed there on the first real board (every boot ended in 'A stack overflow in task main').
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# The emulated serial ports time the line with interrupts: the GPIO functions and the timer's interrupt live in IRAM so that a flash write (a setting saved,
# a firmware update) never delays them.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
CONFIG_GPTIMER_ISR_IRAM_SAFE=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y

# Bluetooth Low Energy (NimBLE) is only the peripheral side, for configuring a node from a phone (docs/BLE_PROVISIONING.md); it is started only when the
# node's settings say so. No bonding is kept, one connection at a time.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# The memory of Bluetooth. The host stack (its buffers, the attribute tables) goes to the external RAM: with it in the internal memory a node in mode "setup" ran out of internal memory (a task that
# did not start, the encryption that failed to allocate). The controller keeps its buffers in the internal memory (the radio needs them there), so it is given only the activities it uses: one
# advertisement and one connection, and a spare. A cached sdkconfig keeps an older value of these: delete the .compile cache before building (tools/check_sdkconfig.py compares the result).
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_CTRL_BLE_MAX_ACT=3

# A crash leaves its core dump in the partition made for it (coredump), in the ELF form with a checksum, so the summary (the task, the place, the backtrace) can be read on the node and the
# image downloaded by an administrator (main/node_diag.cpp). Up to 32 tasks are saved. The partition is 128 KB in the tables of the repository; a node whose table is the older 64 KB one
# (flashed by cable before this) may find a long dump does not fit, which the health report then shows as a node with no dump.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32
